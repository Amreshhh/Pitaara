{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-rates",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/update-rates",
      "schedule": "30 10 * * *"
    }
  ]
}